---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Badge from './Badge.astro';
import ProjectCard from './ProjectCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { Language } from '../i18n/translations';
import { useTranslations, getLocalizedPath } from '../i18n/translations';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Language;
}

const { project, lang } = Astro.props;
const { Content } = await project.render();
const t = useTranslations(lang);
const projectT = t('project');
const isPasswordProtected = project.data.passwordProtected;

// Helper to get localized href
const getHref = (path: string) => getLocalizedPath(path, lang);

// Get all projects for featured section
const allProjects = await getCollection('projects');
const featuredProjects = project.data.featuredProjectSlugs
  ? allProjects.filter((p) => project.data.featuredProjectSlugs?.includes(p.slug))
  : allProjects.filter((p) => p.slug !== project.slug).slice(0, 2);
---

<BaseLayout title={`${project.data.title} - Henrique Olson`} description={project.data.cardDescription}>
  <Header lang={lang} currentPath={`/${project.slug}`} />

  {isPasswordProtected && (
    <section
      class="px-4 pb-16 pt-28 sm:px-6 lg:px-8"
      data-access-gate
      data-password-hash={project.data.accessPasswordHash}
    >
      <div class="mx-auto max-w-xl rounded-2xl border border-border bg-card p-6 shadow-2xl sm:p-10">
        <Badge variant="protected">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="4" y="10" width="16" height="11" rx="2" stroke-width="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke-width="2" stroke-linecap="round" />
          </svg>
          {lang === 'pt' ? 'Protegido por senha' : 'Password protected'}
        </Badge>
        <h1 class="mt-6 font-druk text-3xl sm:text-4xl" style={`color: ${project.data.titleColor}`}>
          {project.data.displayTitle}
        </h1>
        <p class="mt-3 font-seravek text-base leading-relaxed text-muted-foreground">
          {project.data.accessPasswordHash
            ? lang === 'pt'
              ? 'Insira a senha para acessar o estudo de caso.'
              : 'Enter the password to access this case study.'
            : lang === 'pt'
              ? 'Este estudo de caso está disponível mediante solicitação. Entre em contato pelo LinkedIn para pedir acesso.'
              : 'This case study is available by request. Contact me on LinkedIn to request access.'}
        </p>

        {project.data.accessPasswordHash && (
          <form class="mt-8 space-y-4" data-access-form>
            <div>
              <label for="case-access-password" class="mb-2 block font-proxima text-sm font-medium">
                {lang === 'pt' ? 'Senha' : 'Password'}
              </label>
              <input
                id="case-access-password"
                name="password"
                type="password"
                required
                autocomplete="current-password"
                class="w-full rounded-lg border border-border bg-input px-4 py-3 font-proxima text-foreground outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30"
                placeholder={lang === 'pt' ? 'Digite a senha' : 'Enter password'}
                aria-describedby="case-access-error"
              />
            </div>
            <p id="case-access-error" class="text-sm text-red-300" role="alert" aria-live="polite" data-access-error hidden>
              {lang === 'pt' ? 'A senha não confere. Tente novamente ou solicite acesso pelo LinkedIn.' : 'That password did not match. Try again or request access on LinkedIn.'}
            </p>
            <button
              type="submit"
              class="w-full rounded-lg bg-primary px-5 py-3 font-proxima font-semibold text-primary-foreground transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {lang === 'pt' ? 'Acessar estudo de caso' : 'Unlock case study'}
            </button>
          </form>
        )}

        <a
          href="https://linkedin.com/in/henriqueolson"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 flex w-full items-center justify-center rounded-lg border border-border px-5 py-3 font-proxima font-medium transition hover:border-primary hover:text-primary"
        >
          {lang === 'pt' ? 'Solicitar senha pelo LinkedIn' : 'Request password on LinkedIn'}
        </a>
      </div>
    </section>
  )}

  <main id="project-content" class="pt-24 pb-16 px-4 sm:px-6 lg:px-8" hidden={isPasswordProtected}>
    <div class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <a href={`${getHref('/')}#portfolio`} class="back-button mb-8 font-proxima text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        {projectT.backToPortfolio}
      </a>

      <!-- Project Header -->
      <div class="mb-12">
        <h1 class="font-druk text-4xl sm:text-5xl md:text-6xl mb-2" style={`color: ${project.data.titleColor}`}>
          {project.data.displayTitle}
        </h1>
        <p class="font-proxima text-xl mb-6" style={`color: ${project.data.titleColor}`}>
          {project.data.client}
        </p>
      </div>

      <!-- Overview -->
      <div class="mb-12">
        <h2 class="font-seravek text-2xl mb-4">{projectT.overview}</h2>
        <p class="font-proxima text-lg leading-relaxed text-[#ffffff] mb-6">
          {project.data.overviewDescription}
        </p>

        <!-- Tags -->
        {project.data.tags && project.data.tags.length > 0 && (
          <div class="mb-8">
            <h3 class="font-proxima text-lg mb-3">{projectT.tags}</h3>
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <Badge variant="gradient">{tag}</Badge>
              ))}
            </div>
          </div>
        )}

        <!-- Key Results -->
        {project.data.keyResults && project.data.keyResults.length > 0 && (
          <div class="mb-8">
            <h3 class="font-druk text-3xl sm:text-4xl mb-4 text-primary">{project.data.keyResultsTitle ?? projectT.keyResults}</h3>
            <ul class="space-y-2">
              {project.data.keyResults.map((result) => (
                <li class="text-primary font-proxima text-lg">
                  {project.data.keyResultsPrefix && <span class="mr-2 opacity-70" aria-hidden="true">{project.data.keyResultsPrefix}</span>}
                  <mark>{result.metric}</mark> {result.description}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {project.slug === 'dealroom' && (
        <div
          class="case-section-divider"
          style={`--case-accent: ${project.data.titleColor}`}
          aria-hidden="true"
        />
      )}

      <!-- MDX Content -->
      <div
        class={`prose prose-invert prose-lg max-w-none mb-16 ${project.slug === 'dealroom' ? 'project-case-content' : ''}`}
        style={`--case-accent: ${project.data.titleColor}`}
      >
        <Content />
      </div>

      <!-- Send Message Button -->
      <a
        href="https://linkedin.com/in/henriqueolson"
        target="_blank"
        rel="noopener noreferrer"
        class="send-message-btn w-full flex items-center justify-center gap-2 bg-primary text-primary-foreground font-proxima font-medium py-4 px-6 rounded-lg mb-16 transition-all hover:opacity-90"
      >
        {lang === 'en' ? 'Send me a message' : 'Envie-me uma mensagem'}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Featured Projects -->
      {featuredProjects.length > 0 && (
        <section class="border-t border-border pt-16">
          <h2 class="font-seravek text-2xl mb-8 text-center">
            {lang === 'en' ? 'Featured Projects' : 'Projetos em Destaque'}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredProjects.map((featuredProject) => (
              <ProjectCard
                title={featuredProject.data.title}
                displayTitle={featuredProject.data.displayTitle}
                titleColor={featuredProject.data.titleColor}
                client={featuredProject.data.client}
                description={featuredProject.data.cardDescription}
                badges={featuredProject.data.badges}
                slug={featuredProject.slug}
                image={featuredProject.data.cardImage}
                passwordProtected={featuredProject.data.passwordProtected}
                comingSoon={featuredProject.data.comingSoon}
                lang={lang}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <Footer lang={lang} />

  <script>
    const gate = document.querySelector<HTMLElement>('[data-access-gate]');
    const form = gate?.querySelector<HTMLFormElement>('[data-access-form]');
    const content = document.querySelector<HTMLElement>('#project-content');
    const passwordInput = form?.querySelector<HTMLInputElement>('input[name="password"]');
    const errorMessage = gate?.querySelector<HTMLElement>('[data-access-error]');
    const expectedHash = gate?.dataset.passwordHash;

    if (gate && form && content && passwordInput && errorMessage && expectedHash) {
      const unlockCase = () => {
        gate.hidden = true;
        content.hidden = false;
      };

      const lockCase = () => {
        gate.hidden = false;
        content.hidden = true;
        form.reset();
        errorMessage.hidden = true;
        passwordInput.removeAttribute('aria-invalid');
      };

      // A restored back/forward page must show the prompt again too.
      window.addEventListener('pagehide', lockCase);
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) lockCase();
      });

      passwordInput.addEventListener('input', () => {
        errorMessage.hidden = true;
        passwordInput.removeAttribute('aria-invalid');
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorMessage.hidden = true;

        try {
          const bytes = new TextEncoder().encode(passwordInput.value);
          const digest = await window.crypto.subtle.digest('SHA-256', bytes);
          const hash = Array.from(new Uint8Array(digest))
            .map((byte) => byte.toString(16).padStart(2, '0'))
            .join('');

          if (hash === expectedHash) {
            unlockCase();
            return;
          }
        } catch {
          // Keep the access prompt usable if browser cryptography is unavailable.
        }

        errorMessage.hidden = false;
        passwordInput.setAttribute('aria-invalid', 'true');
        passwordInput.focus();
      });
    }
  </script>
</BaseLayout>
