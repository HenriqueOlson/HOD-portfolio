---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import type { Language } from '../i18n/translations';
import { useTranslations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
}

const {
  title = 'Henrique Olson - Product Designer',
  description = 'Turning complex challenges into successful digital products.',
  lang = 'en',
} = Astro.props;
const accessText = useTranslations(lang)('access');
const projects = await getCollection('projects');
const accessPasswordHash = projects.find((project) => project.data.accessPasswordHash)?.data.accessPasswordHash ?? '';
const homePath = lang === 'pt' ? '/pt/' : '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CB892XC3Q5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CB892XC3Q5', {
        page_path: window.location.pathname,
        send_page_view: true
      });

      // Track all link clicks
      document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (link) {
          gtag('event', 'click', {
            event_category: 'link',
            event_label: link.href || link.textContent,
            value: 1
          });
        }
      });

      // Track all button clicks
      document.addEventListener('click', function(e) {
        const button = e.target.closest('button');
        if (button) {
          gtag('event', 'click', {
            event_category: 'button',
            event_label: button.textContent || button.className,
            value: 1
          });
        }
      });

      // Track form submissions
      document.addEventListener('submit', function(e) {
        gtag('event', 'form_submit', {
          event_category: 'form',
          event_label: e.target.action || 'form_submission',
          value: 1
        });
      });

      // Track scroll depth
      let scrollDepths = [25, 50, 75, 100];
      let scrollDepthsTriggered = [];
      window.addEventListener('scroll', function() {
        const scrollPercent = Math.round((window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100);
        scrollDepths.forEach(function(depth) {
          if (scrollPercent >= depth && !scrollDepthsTriggered.includes(depth)) {
            scrollDepthsTriggered.push(depth);
            gtag('event', 'scroll_depth', {
              event_category: 'engagement',
              event_label: depth + '%',
              value: depth
            });
          }
        });
      });
    </script>

    <!-- Hotjar Tracking Code for 2026portfolioClaudeVersion -->
    <script is:inline>
      (function(h,o,t,j,a,r){
        h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
        h._hjSettings={hjid:6676360,hjsv:6};
        a=o.getElementsByTagName('head')[0];
        r=o.createElement('script');r.async=1;
        r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
        a.appendChild(r);
      })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background text-foreground" data-access-password-hash={accessPasswordHash} data-home-path={homePath}>
    <slot />

    <div class="site-access-overlay" data-site-access-overlay hidden>
      <section class="site-access-dialog" role="dialog" aria-modal="true" aria-labelledby="site-access-title" aria-describedby="site-access-description">
        <p class="site-access-eyebrow">{accessText.eyebrow}</p>
        <h2 id="site-access-title" class="site-access-title">{accessText.title}</h2>
        <p id="site-access-description" class="site-access-description">{accessText.description}</p>

        <div class="site-access-choices" data-access-choices>
          <button type="button" class="site-access-visitor" data-access-visitor>{accessText.visitor}</button>
          <button type="button" class="site-access-password-choice" data-access-password-choice>{accessText.havePassword}</button>
        </div>

        <form class="site-access-form" data-site-access-form hidden>
          <label for="site-access-password">{accessText.passwordLabel}</label>
          <input id="site-access-password" name="password" type="password" autocomplete="current-password" required placeholder={accessText.passwordPlaceholder} aria-describedby="site-access-error" />
          <p id="site-access-error" class="site-access-error" role="alert" aria-live="polite" data-site-access-error hidden>{accessText.invalidPassword}</p>
          <div class="site-access-form-actions">
            <button type="button" class="site-access-back" data-access-back>{accessText.back}</button>
            <button type="submit" class="site-access-submit">{accessText.unlock}</button>
          </div>
        </form>

        <p class="site-access-expiry">{accessText.expiry}</p>
      </section>
    </div>

    <script is:inline>
      (() => {
        const overlay = document.querySelector('[data-site-access-overlay]');
        const visitorButton = overlay?.querySelector('[data-access-visitor]');
        const passwordChoiceButton = overlay?.querySelector('[data-access-password-choice]');
        const choices = overlay?.querySelector('[data-access-choices]');
        const form = overlay?.querySelector('[data-site-access-form]');
        const backButton = overlay?.querySelector('[data-access-back]');
        const input = form?.querySelector('input[name="password"]');
        const errorMessage = overlay?.querySelector('[data-site-access-error]');
        const accessKey = 'portfolio-site-access';
        const sessionLength = 10 * 60 * 1000;
        let expiryTimer;

        if (!overlay || !visitorButton || !passwordChoiceButton || !choices || !form || !backButton || !input || !errorMessage) return;

        const readSession = () => {
          try {
            const session = JSON.parse(sessionStorage.getItem(accessKey) || 'null');
            if (session && (session.mode === 'visitor' || session.mode === 'password') && session.expiresAt > Date.now()) return session;
          } catch { /* Start a fresh access choice when storage is unavailable. */ }
          sessionStorage.removeItem(accessKey);
          return null;
        };

        const showDialog = () => {
          overlay.hidden = false;
          document.body.classList.add('site-access-open');
          window.requestAnimationFrame(() => (input.offsetParent ? input : visitorButton).focus());
        };

        const hideDialog = () => {
          overlay.hidden = true;
          document.body.classList.remove('site-access-open');
        };

        const expireSession = () => {
          sessionStorage.removeItem(accessKey);
          window.clearTimeout(expiryTimer);
          document.querySelectorAll('[data-password-protected="true"]').forEach((card) => { card.hidden = false; });
          window.dispatchEvent(new CustomEvent('portfolio-access-expired'));
          showDialog();
        };

        const saveSession = (mode) => {
          const session = { mode, expiresAt: Date.now() + sessionLength };
          sessionStorage.setItem(accessKey, JSON.stringify(session));
          document.querySelectorAll('[data-password-protected="true"]').forEach((card) => {
            card.hidden = mode === 'visitor';
          });
          hideDialog();
          window.dispatchEvent(new CustomEvent('portfolio-access-mode-change', { detail: session }));
          expiryTimer = window.setTimeout(expireSession, sessionLength);

          if (mode === 'visitor' && document.querySelector('[data-protected-project="true"]')) {
            window.location.replace(`${document.body.dataset.homePath || '/'}#portfolio`);
          }
        };

        const activatePasswordEntry = () => {
          choices.hidden = true;
          form.hidden = false;
          errorMessage.hidden = true;
          input.focus();
        };

        visitorButton.addEventListener('click', () => saveSession('visitor'));
        passwordChoiceButton.addEventListener('click', activatePasswordEntry);
        backButton.addEventListener('click', () => {
          form.hidden = true;
          choices.hidden = false;
          errorMessage.hidden = true;
          input.value = '';
          visitorButton.focus();
        });
        input.addEventListener('input', () => {
          errorMessage.hidden = true;
          input.removeAttribute('aria-invalid');
        });

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          errorMessage.hidden = true;
          const expectedHash = document.body.dataset.accessPasswordHash;
          try {
            const bytes = new TextEncoder().encode(input.value);
            const digest = await window.crypto.subtle.digest('SHA-256', bytes);
            const hash = Array.from(new Uint8Array(digest)).map((byte) => byte.toString(16).padStart(2, '0')).join('');
            if (expectedHash && hash === expectedHash) {
              saveSession('password');
              return;
            }
          } catch { /* Keep the form available if browser cryptography is unavailable. */ }
          errorMessage.hidden = false;
          input.setAttribute('aria-invalid', 'true');
          input.focus();
        });

        overlay.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') event.preventDefault();
          if (event.key !== 'Tab') return;
          const focusable = Array.from(overlay.querySelectorAll('button:not([disabled]), input:not([disabled])')).filter((element) => !element.closest('[hidden]'));
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        const currentSession = readSession();
        if (currentSession) {
          document.querySelectorAll('[data-password-protected="true"]').forEach((card) => {
            card.hidden = currentSession.mode === 'visitor';
          });
          window.setTimeout(() => window.dispatchEvent(new CustomEvent('portfolio-access-mode-change', { detail: currentSession })), 0);
          expiryTimer = window.setTimeout(expireSession, currentSession.expiresAt - Date.now());
          if (currentSession.mode === 'visitor' && document.querySelector('[data-protected-project="true"]')) {
            window.location.replace(`${document.body.dataset.homePath || '/'}#portfolio`);
          } else {
            hideDialog();
          }
        } else {
          showDialog();
        }
      })();
    </script>
  </body>
</html>
